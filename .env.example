# Postgres connection string (Neon / Supabase / Vercel Postgres). Leave empty locally to use a built-in file database.
DATABASE_URL=
# Long random string used to sign login cookies
SESSION_SECRET=change-me-to-a-long-random-string
# Your SchoolCove admin login (created automatically on first run)
ADMIN_EMAIL=admin@schoolcove.in
ADMIN_PASSWORD=change-me
# Price you charge a school per lead (shown in dashboards), in rupees
LEAD_PRICE=500
# Optional: Google Places API key. When set, school pages show the live Google rating and recent Google reviews.
GOOGLE_PLACES_API_KEY=
